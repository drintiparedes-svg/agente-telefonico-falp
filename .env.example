# ── Servicio ────────────────────────────────────────────────────────────────
NODE_ENV=development
PUERTO=8080
HOST=0.0.0.0
NIVEL_LOG=info
DB_RUTA=./datos/agente.db

# ── Seguridad ───────────────────────────────────────────────────────────────
# Clave con la que la plataforma firma los webhooks. Sin ella no se acepta
# ningún resultado de llamada.
WEBHOOK_SECRETO=cambiar-en-produccion-secreto-hmac
# Token que la plataforma presenta al invocar el endpoint de LLM propio.
LLM_TOKEN=cambiar-en-produccion-token-llm

# ── Clasificador ────────────────────────────────────────────────────────────
# `simulado` no hace red: reglas deterministas, para desarrollo y CI.
CLASIFICADOR=simulado
# ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-haiku-4-5

# ── Telefonía ───────────────────────────────────────────────────────────────
# Sin estas variables el servicio usa un cliente de voz simulado.
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=
# ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# Proveedor del número de ELEVENLABS_PHONE_NUMBER_ID: twilio (recomendado) o sip_trunk.
# Ese número es opcional: en producción el grupo se administra en /admin/numeros.
TELEFONIA_PROVEEDOR=twilio
# Llamadas por segundo de la cuenta Twilio. Parte en 1; hasta 5 con perfil de negocio.
TWILIO_CPS=1
# Techo de llamadas simultáneas con que entra cada número recién sincronizado.
CONCURRENCIA_POR_NUMERO=5
# conference: el operador oye un aviso con el motivo. blind: sin aviso.
TRANSFERENCIA_TIPO=conference
# Token de /admin/*. Sin él esos endpoints no existen. Mínimo 16 caracteres.
# ADMIN_TOKEN=

# Número de respaldo para transferir a una persona cuando ningún destino de
# /admin/destinos aplica por motivo, servicio u horario.
# En producción el servicio NO arranca sin esto: un agente clínico sin ruta de
# escape a persona no debe operar.
NUMERO_TRANSFERENCIA=

# Concurrencia máxima de llamadas salientes. Debe quedar por debajo del límite
# del plan contratado, reservando capacidad para llamadas entrantes.
CONCURRENCIA_MAX=10

# Días de retención de audio. Este servicio no almacena audio.
RETENCION_AUDIO_DIAS=0

# ── Tareas por cron HTTP (solo plataformas sin proceso persistente) ─────────
# Con este valor definido aparecen los endpoints GET /tareas/{cola,despacho,
# conciliacion}, protegidos por `Authorization: Bearer <CRON_SECRET>`. Vercel
# envía esa cabecera automáticamente si la variable se llama CRON_SECRET.
# CRON_SECRET=
